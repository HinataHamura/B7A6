{
  "info": {
    "name": "Roomly - Housing & Roommate Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "REST API collection for the Roomly Housing & Roommate Platform backend."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "listingId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Tenant)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nusrat Jahan\",\n  \"email\": \"tenant.demo@roomly.com\",\n  \"password\": \"Tenant123!\",\n  \"role\": \"TENANT\",\n  \"phone\": \"01722222222\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register (Landlord)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Karim Rahman\",\n  \"email\": \"landlord.demo@roomly.com\",\n  \"password\": \"Landlord123!\",\n  \"role\": \"LANDLORD\",\n  \"phone\": \"01711111111\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tenant.demo@roomly.com\",\n  \"password\": \"Tenant123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@roomly.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<google-id-token>\",\n  \"role\": \"TENANT\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/google", "host": ["{{baseUrl}}"], "path": ["auth", "google"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"<refresh-token>\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth", "refresh-token"] }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Tenant123!\",\n  \"newPassword\": \"NewTenant123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth", "change-password"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Listings",
      "item": [
        {
          "name": "Create Listing (Landlord)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cozy Private Room in Dhanmondi\",\n  \"description\": \"A well-lit private room close to Dhanmondi Lake.\",\n  \"type\": \"PRIVATE_ROOM\",\n  \"rentAmount\": 12000,\n  \"securityDeposit\": 12000,\n  \"bedrooms\": 1,\n  \"bathrooms\": 1,\n  \"maxOccupants\": 1,\n  \"addressLine\": \"Road 8, Dhanmondi\",\n  \"city\": \"Dhaka\",\n  \"area\": \"Dhanmondi\",\n  \"latitude\": 23.7461,\n  \"longitude\": 90.3742,\n  \"amenities\": [\"WiFi\", \"AC\"],\n  \"images\": [],\n  \"genderPreference\": \"FEMALE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/listings", "host": ["{{baseUrl}}"], "path": ["listings"] }
          }
        },
        {
          "name": "Get All Listings (filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/listings?city=Dhaka&minRent=5000&maxRent=20000&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["listings"],
              "query": [
                { "key": "city", "value": "Dhaka" },
                { "key": "minRent", "value": "5000" },
                { "key": "maxRent", "value": "20000" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Nearby Listings (geolocation)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/listings/nearby?latitude=23.7461&longitude=90.3742&radiusKm=5",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "nearby"],
              "query": [
                { "key": "latitude", "value": "23.7461" },
                { "key": "longitude", "value": "90.3742" },
                { "key": "radiusKm", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Get My Listings (Landlord)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/listings/my-listings", "host": ["{{baseUrl}}"], "path": ["listings", "my-listings"] }
          }
        },
        {
          "name": "Get Listing By Id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/listings/{{listingId}}", "host": ["{{baseUrl}}"], "path": ["listings", "{{listingId}}"] }
          }
        },
        {
          "name": "Update Listing (Landlord)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"PUBLISHED\",\n  \"rentAmount\": 13000\n}" },
            "url": { "raw": "{{baseUrl}}/listings/{{listingId}}", "host": ["{{baseUrl}}"], "path": ["listings", "{{listingId}}"] }
          }
        },
        {
          "name": "Delete Listing (Landlord)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/listings/{{listingId}}", "host": ["{{baseUrl}}"], "path": ["listings", "{{listingId}}"] }
          }
        },
        {
          "name": "Toggle Save Listing (Tenant)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/listings/{{listingId}}/save", "host": ["{{baseUrl}}"], "path": ["listings", "{{listingId}}", "save"] }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking (Tenant)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"moveInDate\": \"2026-10-01\",\n  \"message\": \"Looking forward to moving in!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "Get My Bookings (Tenant)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/bookings/my-bookings", "host": ["{{baseUrl}}"], "path": ["bookings", "my-bookings"] }
          }
        },
        {
          "name": "Get Landlord Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/bookings/landlord-bookings", "host": ["{{baseUrl}}"], "path": ["bookings", "landlord-bookings"] }
          }
        },
        {
          "name": "Get Booking By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}"] }
          }
        },
        {
          "name": "Update Booking Status (Landlord confirms)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CONFIRMED\"\n}" },
            "url": { "raw": "{{baseUrl}}/bookings/{{bookingId}}/status", "host": ["{{baseUrl}}"], "path": ["bookings", "{{bookingId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Initiate Payment (Tenant)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"purpose\": \"BOOKING_ADVANCE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments/initiate", "host": ["{{baseUrl}}"], "path": ["payments", "initiate"] }
          }
        },
        {
          "name": "Get Payment History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/payments/history", "host": ["{{baseUrl}}"], "path": ["payments", "history"] }
          }
        }
      ]
    },
    {
      "name": "Roommates",
      "item": [
        {
          "name": "Find Compatible Matches (Tenant)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/roommates/matches", "host": ["{{baseUrl}}"], "path": ["roommates", "matches"] }
          }
        },
        {
          "name": "Send Roommate Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverId\": \"<tenant-profile-id>\",\n  \"message\": \"Hey, want to room together?\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/roommates/requests", "host": ["{{baseUrl}}"], "path": ["roommates", "requests"] }
          }
        },
        {
          "name": "Get Sent Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/roommates/requests/sent", "host": ["{{baseUrl}}"], "path": ["roommates", "requests", "sent"] }
          }
        },
        {
          "name": "Get Received Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/roommates/requests/received", "host": ["{{baseUrl}}"], "path": ["roommates", "requests", "received"] }
          }
        },
        {
          "name": "Respond to Request",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACCEPTED\"\n}" },
            "url": { "raw": "{{baseUrl}}/roommates/requests/<requestId>/respond", "host": ["{{baseUrl}}"], "path": ["roommates", "requests", "<requestId>", "respond"] }
          }
        },
        {
          "name": "Cancel Request",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/roommates/requests/<requestId>/cancel", "host": ["{{baseUrl}}"], "path": ["roommates", "requests", "<requestId>", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "Reviews",
      "item": [
        {
          "name": "Create Review (Tenant, completed booking)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"rating\": 5,\n  \"comment\": \"Great stay, very responsive landlord!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reviews", "host": ["{{baseUrl}}"], "path": ["reviews"] }
          }
        },
        {
          "name": "Get Listing Reviews",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reviews/listing/{{listingId}}", "host": ["{{baseUrl}}"], "path": ["reviews", "listing", "{{listingId}}"] }
          }
        },
        {
          "name": "Get Landlord Reviews",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reviews/landlord/<landlordProfileId>", "host": ["{{baseUrl}}"], "path": ["reviews", "landlord", "<landlordProfileId>"] }
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Get Conversation List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/messages/conversations", "host": ["{{baseUrl}}"], "path": ["messages", "conversations"] }
          }
        },
        {
          "name": "Get Unread Count",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/messages/unread-count", "host": ["{{baseUrl}}"], "path": ["messages", "unread-count"] }
          }
        },
        {
          "name": "Get Conversation With User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/messages/{{userId}}", "host": ["{{baseUrl}}"], "path": ["messages", "{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get My Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/notifications", "host": ["{{baseUrl}}"], "path": ["notifications"] }
          }
        },
        {
          "name": "Mark One As Read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/notifications/<notificationId>/read", "host": ["{{baseUrl}}"], "path": ["notifications", "<notificationId>", "read"] }
          }
        },
        {
          "name": "Mark All As Read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/notifications/read-all", "host": ["{{baseUrl}}"], "path": ["notifications", "read-all"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          }
        },
        {
          "name": "Update User Status (Block/Unblock)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"BLOCKED\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}", "status"] }
          }
        },
        {
          "name": "Verify Landlord",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/landlords/<landlordProfileId>/verify", "host": ["{{baseUrl}}"], "path": ["admin", "landlords", "<landlordProfileId>", "verify"] }
          }
        },
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminAccessToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] }
          }
        }
      ]
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "Upload Images",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "images", "type": "file", "src": [] }]
            },
            "url": {
              "raw": "{{baseUrl}}/upload/images?folder=listings",
              "host": ["{{baseUrl}}"],
              "path": ["upload", "images"],
              "query": [{ "key": "folder", "value": "listings" }]
            }
          }
        }
      ]
    }
  ]
}
